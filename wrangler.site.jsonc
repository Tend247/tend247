// tend247.com: the static marketing site (landing, roadmap, architecture), separate from the
// app Worker in wrangler.jsonc. Assets only: no database, no secrets.
//   npm run site:deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tend247-site",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist-site",
    "not_found_handling": "single-page-application"
  },
  // Requires the tend247.com zone in the same Cloudflare account, and no existing DNS records
  // for these two hostnames (remove any parking or forwarding records first).
  "routes": [
    { "pattern": "tend247.com", "custom_domain": true },
    { "pattern": "www.tend247.com", "custom_domain": true }
  ]
}
