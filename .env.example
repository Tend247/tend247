# Tend 24/7 environment template. Copy to .env for local scripts; never commit a real .env.
# In production these live in Workers secrets/vars (see wrangler.jsonc).

# Direct (non-Hyperdrive) connection used by migrations and seed scripts.
# This role OWNS the schema. It must not be a superuser in production.
TEND247_DB_OWNER_URL=postgres://tend247_owner:change-me@127.0.0.1:54329/tend247_dev

# Role the Worker connects as (through Hyperdrive). Must NOT be a superuser and must NOT
# have BYPASSRLS, or tenant isolation is lost. The app refuses to start if it is.
TEND247_DB_APP_ROLE=tend247_app
# Optional: if set, `npm run db:migrate` creates the app role with this password when missing.
TEND247_DB_APP_PASSWORD=

# Session signing secret: at least 32 random characters.
TEND247_SESSION_SECRET=replace-with-at-least-32-random-characters

# Local development only: allow passwordless sign-in as an existing user.
TEND247_DEV_LOGIN=false

# OIDC single sign-on for staff (Okta, Microsoft Entra ID, Google Workspace, ...).
TEND247_OIDC_ISSUER=
TEND247_OIDC_CLIENT_ID=
TEND247_OIDC_CLIENT_SECRET=
# off | agent | requester: create a user on first OIDC sign-in with this role (needs allowed domains).
TEND247_OIDC_AUTO_PROVISION=off
# Email domains that may link to existing people or be provisioned through SSO, comma-separated.
TEND247_OIDC_ALLOWED_DOMAINS=
# true only for a single-tenant provider that omits email_verified (Microsoft Entra ID).
TEND247_OIDC_TRUST_UNVERIFIED_EMAIL=false

# Comma-separated email domains allowed to self-register as requesters via magic link.
TEND247_REQUESTER_DOMAINS=

# Marketing pages (landing, roadmap, architecture) at /. Only tend247.com turns this on.
TEND247_PUBLIC_SITE=false
TEND247_REPO_URL=

# Tests (npm test): owner and app connection strings for a disposable test database.
TEND247_TEST_DB_OWNER_URL=postgres://tend247_owner:change-me@127.0.0.1:54329/tend247_test
TEND247_TEST_DB_APP_URL=postgres://tend247_app:change-me@127.0.0.1:54329/tend247_test
